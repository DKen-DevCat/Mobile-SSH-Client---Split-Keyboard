// SplitTerm の共通設定（docs/design.md「配布」）。lfm3-vl-server の iPhone アプリと同じ作り。
// Team は git に入れない: ios/Config/Local.xcconfig に DEVELOPMENT_TEAM を書く（Local.xcconfig.example）。
// scripts/ios_reinstall.sh は Xcode の設定から無料の Team を読んで、コマンドで渡す

SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
// iPhone と iPad（1 つのレイアウト算出で両方を扱う）
TARGETED_DEVICE_FAMILY = 1,2
// iPad 第 5 世代（A9）が使える最後の版
IPHONEOS_DEPLOYMENT_TARGET = 16.0

PRODUCT_NAME = SplitTerm
// 無料の Team は 7 日に作れる App ID が 10 個まで。キーチェーンの鍵（Secure Enclave の鍵・ホスト鍵）も Bundle ID に付くので変えない
PRODUCT_BUNDLE_IDENTIFIER = io.github.dken-devcat.splitterm
MARKETING_VERSION = 0.1
// scripts/ios_reinstall.sh が作った日時（yyyyMMddHHmm）で上書きする
CURRENT_PROJECT_VERSION = 1

CODE_SIGN_STYLE = Automatic

// NIO と UIKit をまたぐ所があるので、Swift 6 の厳密な検査は Mac でビルドを通してから入れる
SWIFT_VERSION = 5.0
ENABLE_USER_SCRIPT_SANDBOXING = YES
ALWAYS_SEARCH_USER_PATHS = NO
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
MTL_FAST_MATH = YES

GENERATE_INFOPLIST_FILE = YES
// 生成される Info.plist に足すもの（シーン、ファイル共有、120Hz）だけを書いたファイル
INFOPLIST_FILE = Config/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = SplitTerm
INFOPLIST_KEY_NSFaceIDUsageDescription = 起動時と復帰時にターミナルのロックを解くため
INFOPLIST_KEY_NSLocalNetworkUsageDescription = 同じネットワークの SSH の接続先につなぐため
INFOPLIST_KEY_LSSupportsOpeningDocumentsInPlace = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIStatusBarHidden = YES
// 横持ちだけ（docs/design.md「画面構成」）。iPad も同じ
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
// 横持ちだけの iPad アプリは Split View に入れない。窓の大きさが変わったときは、レイアウトの算出で縮める
INFOPLIST_KEY_UIRequiresFullScreen = YES
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

#include? "Local.xcconfig"
