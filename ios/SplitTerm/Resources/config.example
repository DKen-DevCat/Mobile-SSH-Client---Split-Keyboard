# Mobile-SSH-Client---Split-Keyboard の設定（Ghostty と同じく、このファイル 1 枚ですべてを決める）
#
# 書き方
#   key = value      1 行に 1 つ。# で始まる行は読み飛ばす
#   key =            値を空にすると既定値に戻る
#   "..."            空白を残したい値は引用符で囲む
#   palette と host は何度でも書ける
#
# 置き場所
#   iPhone / iPad: 「ファイル」アプリ > この iPhone 内 > Mobile-SSH-Client---Split-Keyboard > config
#                  （アプリの ＋ を長押し →「設定を編集」でも直せる）
#   Mac:           ~/.config/splitterm/config を scripts/ios_push_config.sh で送る
# 保存した瞬間に読み直して効く。読めない行は飛ばし、画面の ⚠ に行番号を出す。
# 鍵やパスワードはここに書かない（鍵は Secure Enclave、ホスト鍵はキーチェーン）。
#
# 下の値はすべて既定値。変えたい行の先頭の # を外す。

# ─── 接続 ───────────────────────────────────────────────
# 形: host = 名前 ユーザー@アドレス[:ポート] [tmux=セッション名|none] [auth=key|password]
#   tmux を指定すると、接続時に `tmux new-session -A -s <名前>` で続きに戻る（既定 main）。
#   タブごとに別のセッションに入る（1 つ目は main、2 つ目から main-2、main-3…）。タブを閉じても tmux は残る
#   tmux=none なら素のシェル
# host = mac me@my-mac.example.ts.net tmux=main
# host = pi pi@192.168.1.20:2222 tmux=none

# 起動時につなぐ host の名前。空なら最初の host、none ならつながない
# auto-connect =

# 接続先に伝える端末の種類
# term = xterm-256color

# TCP の keepalive の間隔（切れた接続を早く見つける）。0 で使わない
# keepalive = 15s

# 切れたら自動で繋ぎ直す（バックグラウンドからの復帰・回線の切り替え）
# reconnect = true

# パスワード認証を許す（既定は公開鍵だけ。パスワードは毎回聞き、保存しない）
# password-auth = false

# ─── 表示 ───────────────────────────────────────────────
# 等幅の英字フォント。system-mono は iOS の SF Mono。Menlo・Courier New なども使える
# font-family = system-mono

# 日本語のフォールバック
# font-family-cjk = Hiragino Sans

# 100% 表示のときの文字の大きさ（pt）
# font-size = 10

# 表示倍率の段（%）。ピンチ・倍率ボタン・command + − / = はこの段で止まる。先頭が起動時
# zoom-steps = 85, 100

# 色（#RRGGBB）。color-space が display-p3 なら Display P3 の値として描く（sRGB より鮮やか）。
# Mac の Ghostty と同じ色にするには、Mac で splitterm theme import を実行する（color-space は Ghostty の window-colorspace、
# 既定の srgb になる）
# color-space = display-p3
# background = #07090D
# foreground = #E6EDF3
# cursor-color = #2F81F7
# accent = #2F81F7
# selection-background = #264F78

# 16 色のパレット（番号=色）
# palette = 0=#1C2128
# palette = 1=#FF5F6D
# palette = 2=#3FE08A
# palette = 3=#FFB454
# palette = 4=#2F81F7
# palette = 5=#FF6AC1
# palette = 6=#5CE1E6
# palette = 7=#C9D1D9
# palette = 8=#545D68
# palette = 9=#FF8A94
# palette = 10=#7BF0B0
# palette = 11=#FFCC85
# palette = 12=#6CA6FF
# palette = 13=#FF9AD6
# palette = 14=#8EEFF2
# palette = 15=#FFFFFF

# 文字と背景のコントラスト比がこれを下回ると、文字色を白か黒の側へ寄せて補正する。1 で補正しない（Ghostty の既定と同じ）。
# 4.5 などにすると読みやすくなる代わりに、暗い色が白っぽくなって薄く見える
# minimum-contrast = 1

# 太字の文字で、文字色がパレットの 0〜7 なら 8〜15 の色にする（true color と既定の文字色は変えない）。Ghostty の bold-is-bright
# bold-is-bright = false

# 文字の輪郭を細い線でなぞって、文字を少し太く描く（macOS の Ghostty の font-thicken の代わり）
# font-thicken = false

# カーソル: block / bar / underline
# cursor-style = block

# カーソルを点滅させる
# cursor-blink = false

# スクロールバックの行数（メモリの上だけに置く）
# scrollback-limit = 10000

# ─── キーボード ─────────────────────────────────────────
# 起動時のキーボード（🌐 の長押しでも選べる）:
#   romaji（分割・ローマ字）/ english（分割・英語。Mac の JIS 配列）/ kana（日本語フリック分割）/
#   flick-romaji（英語フリック分割・ローマ字）/ flick-english（英語フリック分割・英語）
# keyboard = english

# キー 1 つの大きさ u（pt。20〜80）。文字キーは u×u の正方形。
# 横持ちは左のキーボードが幅 8.25u、右が 9.5u、高さ 5.6u。auto は画面の短辺 × 0.064 を切り捨てて 24〜36（iPhone 13 mini で 24、iPad で 36）。
# 縦持ちは Mac の JIS 配列の一体型で幅 14.5u、高さ 5.6u。auto は画面の幅 ÷ 14.5（iPhone 13 mini で 25.86）。
# 大きすぎて収まらないときは、収まる大きさまで縮む
# keyboard-pitch = auto

# ⌫ と矢印の長押しリピート
# key-repeat-delay = 400ms
# key-repeat-interval = 50ms

# option を meta（ESC を前に付ける）として送る（キーに刷ってある option の文字 € と # は、こちらより先に効く）
# option-as-meta = true

# キーに触れたときの振動
# haptics = true

# 改行キーが送るもの
#   auto    接続先が括弧付きペーストを有効にしていれば改行を貼り付けとして、無効なら ESC+CR
#   paste   auto と同じ
#   esc-cr  いつも ESC+CR（zsh・Claude Code の Option+Enter と同じ）
#   ctrl-j  LF。bash・zsh では実行と同じ扱いになるので注意
# newline = auto

# ハードウェアキーボードがつながっていても、画面のキーボードを出し続ける（iPad）
# soft-keyboard-with-hardware = false

# 先行表示（打った文字を、接続先の返事を待たずにカーソルの位置へ出す）
#   instant    押した瞬間に出す（iOS のキーボードと同じ速さ）。確かめる前は 1 行で最初の 1 文字だけ。外れたら、
#              返ってくるのを確かめるまで出さない。password・パスワード・token などの言葉がある行（前の行も見る）では
#              出さない。言葉に当たらない秘密の入力では、その行の最初の 1 文字が最大 1 秒出ることがある
#   confirmed  打った文字が返ってくるのを 1 度見てから出す（行が変わるたびに確かめ直す）。返らない入力では決して出ない
#   off        出さない
# echo-prediction = instant

# ─── 操作 ───────────────────────────────────────────────
# vim・tmux・htop などがマウスを求めたら、タップやスクロールをマウスとして送る
# mouse-reporting = true

# ─── メディア（写真・動画・音声を送る） ─────────────────────────
# 📎 で選んだり撮ったりしたものを、SSH の同じ接続で接続先の受け取り箱へ原本のまま送り、パスを入力行に入れる。
# エージェントが読めない形式のときだけ変換する（HEIC → JPEG、動画 → コンタクトシート、音声 → 文字起こし）

# 送り先のエージェント: claude-code / codex / generic（画像は png・jpeg まで）
# agent = claude-code

# エージェントが読める種類を上書きする（動画や音声を読めるエージェント用）。例: image,video,audio
# agent-media =

# 接続先の受け取り箱（~/ か / で始まる専用のフォルダ。英数と . _ - / だけ。ホームや / そのものは不可）
# 古いものとして消すのは、アプリが付けた名前のファイルだけ。自分の持ち物でないフォルダには送らない
# media-dir = ~/.splitterm/inbox

# 受け取り箱に残す期間（7d・12h。0 で消さない）
# media-retention = 7d

# 写真・動画の位置情報を外す（再圧縮はしない。外せなければ送らない）
# false にする変更は、端末で本人の確認（Face ID かパスコード）の後で効く
# media-strip-location = true

# 送った後に入力行へ入れる文字（{paths} が送ったファイルのパス。Enter は押さない）
# media-insert = "{paths} "

# 動画の送り方
#   auto    エージェントが動画を読めれば原本、読めなければコンタクトシート（＋文字起こし）
#   file    いつも原本 / frames  いつもコンタクトシート / both  両方
# video-mode = auto

# コンタクトシートに並べる枚数（1〜24）と、シートの長い辺（px）
# video-frames = 12
# video-sheet-size = 1568

# 動画の音声を、端末の中で文字にして添える（端末にモデルが無ければ外へ送らずに飛ばす）
# video-transcribe = true

# 音声の送り方: auto（読めれば原本、だめなら文字起こし）/ file / transcript / both
# audio-mode = auto

# ─── 安全 ───────────────────────────────────────────────
# アプリを開くときに Face ID（かパスコード）を求める（いつ求めるかは app-lock-after）
# app-lock = true

# アプリを開いていない時間がこれを超えたら、次に開くときに Face ID を求める（15m・1h・90s。0 で毎回）
# 長くする変更は、端末で本人の確認（Face ID かパスコード）の後で効く
# app-lock-after = 15m

# アプリスイッチャーでターミナルの内容をぼかす
# privacy-blur = true

# アプリからコピーした内容（シェルで選んだ文字。選ぶと自動でコピーされる）を、アプリを離れてから消すまでの時間。
# 前面にいる間は消さない。0 で消さない。他の端末へは渡さない
# clipboard-clear = 60s
